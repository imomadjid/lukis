{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lukis",
  "compatibility_date": "2026-09-06",
  "routes": [{ "pattern": "lukis.imomadjid.com", "custom_domain": true }],
  // Serve only the custom domain. Set explicitly: routes change the workers_dev default.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
  },
}
